{
	"name": "@zextras/carbonio-ui-soap-lib",
	"version": "0.0.0-semantically-released",
	"description": "Carbonio UI SOAP Library",
	"packageManager": "pnpm@10.32.1",
	"types": "./dist/types/exports.d.ts",
	"exports": {
		".": {
			"types": "./dist/types/exports.d.ts",
			"import": "./dist/bundle.mjs",
			"require": "./dist/bundle.cjs"
		}
	},
	"files": [
		"README.md",
		"dist",
		"COPYING",
		"LICENSE",
		"THIRDPARTIES",
		"CHANGELOG.md"
	],
	"scripts": {
		"clean": "rm -rf dist",
		"build": "pnpm run build:js && pnpm run build:types",
		"build:js": "pnpm exec rollup -c rollup.config.mjs",
		"build:types": "tsc -p tsconfig.types.json",
		"lint": "eslint --ext .js,.jsx,.ts,.tsx --resolve-plugins-relative-to node_modules/@zextras/carbonio-ui-configs src",
		"prettify": "prettier --check --write .",
		"prettify:check": "prettier --check .",
		"prettify:check:stagedFiles": "prettier --check $(git --no-pager diff --name-only --cached --diff-filter=d | tr '\\n' ' ')",
		"prepack": "pnpm run build",
		"prepare": "is-ci || husky",
		"type-check": "tsc --noEmit",
		"packTo": "pnpm pack --pack-destination $PKG_PATH && cd $PKG_PATH && pnpm i ./zextras-carbonio-ui-soap-lib-$npm_package_version.tgz",
		"test": "vitest run"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/zextras/carbonio-ui-soap-lib.git"
	},
	"author": "Zextras Dev Team <https://www.zextras.com/carbonio/>",
	"license": "AGPL-3.0-only",
	"devDependencies": {
		"@babel/core": "7.29.0",
		"@babel/plugin-transform-runtime": "7.29.0",
		"@babel/preset-env": "7.29.5",
		"@babel/preset-react": "7.28.5",
		"@babel/preset-typescript": "7.28.5",
		"@commitlint/cli": "19.8.1",
		"@commitlint/config-conventional": "19.8.1",
		"@faker-js/faker": "9.9.0",
		"@rollup/plugin-babel": "6.1.0",
		"@rollup/plugin-commonjs": "28.0.9",
		"@rollup/plugin-node-resolve": "16.0.3",
		"@testing-library/react": "16.3.2",
		"@types/node": "25.7.0",
		"@types/react": "18.3.28",
		"@types/react-dom": "18.3.7",
		"@vitest/coverage-v8": "3.2.4",
		"@zextras/carbonio-ui-configs": "2.1.0",
		"eslint": "8.57.1",
		"eslint-plugin-notice": "1.0.0",
		"husky": "9.1.7",
		"is-ci": "4.1.0",
		"jsdom": "26.1.0",
		"msw": "2.14.6",
		"prettier": "3.8.3",
		"react": "18.3.1",
		"react-dom": "18.3.1",
		"rollup": "4.60.3",
		"sonar-scanner": "3.1.0",
		"@semantic-release/commit-analyzer": "12.0.0",
		"@semantic-release/github": "10.3.5",
		"@semantic-release/npm": "11.0.3",
		"@semantic-release/release-notes-generator": "14.1.0",
		"conventional-changelog-conventionalcommits": "7.0.2",
		"semantic-release": "24.2.9",
		"typescript": "5.9.3",
		"vitest": "4.1.0"
	},
	"dependencies": {
		"@types/ua-parser-js": "0.7.39",
		"ua-parser-js": "1.0.41"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild",
			"msw",
			"sonar-scanner",
			"unrs-resolver"
		]
	}
}
