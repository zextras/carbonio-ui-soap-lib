{
	"name": "@zextras/carbonio-ui-soap-lib",
	"version": "0.0.0-semantically-released",
	"description": "Carbonio UI SOAP Library",
	"types": "./dist/types/exports.d.ts",
	"exports": {
		".": {
			"types": "./dist/types/exports.d.ts",
			"import": "./dist/bundle.mjs",
			"require": "./dist/bundle.cjs"
		}
	},
	"files": [
		"README.md",
		"dist",
		"COPYING",
		"LICENSE",
		"THIRDPARTIES",
		"CHANGELOG.md"
	],
	"scripts": {
		"clean": "rm -rf dist",
		"build": "npm run build:js && npm run build:types",
		"build:js": "npx rollup -c rollup.config.mjs",
		"build:types": "tsc -p tsconfig.types.json",
		"lint": "eslint --ext .js,.jsx,.ts,.tsx --resolve-plugins-relative-to node_modules/@zextras/carbonio-ui-configs src",
		"prettify": "prettier --check --write .",
		"prettify:check": "prettier --check .",
		"prettify:check:stagedFiles": "prettier --check $(git --no-pager diff --name-only --cached | tr '\\n' ' ')",
		"prepack": "npm run build",
		"prepare": "is-ci || husky",
		"type-check": "tsc --noEmit",
		"packTo": "npm pack --pack-destination $PKG_PATH && cd $PKG_PATH && npm i zextras-carbonio-ui-soap-lib-$npm_package_version.tgz",
		"test": "vitest run"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/zextras/carbonio-ui-soap-lib.git"
	},
	"author": "Zextras Dev Team <https://www.zextras.com/carbonio/>",
	"license": "AGPL-3.0-only",
	"devDependencies": {
		"@babel/core": "^7.26.9",
		"@babel/plugin-transform-runtime": "^7.26.9",
		"@babel/preset-env": "^7.26.9",
		"@babel/preset-react": "^7.26.3",
		"@babel/preset-typescript": "^7.26.0",
		"@commitlint/cli": "^19.8.1",
		"@commitlint/config-conventional": "^19.8.1",
		"@faker-js/faker": "^9.6.0",
		"@rollup/plugin-babel": "^6.0.4",
		"@rollup/plugin-commonjs": "^28.0.3",
		"@rollup/plugin-node-resolve": "^16.0.0",
		"@testing-library/react": "16.2",
		"@types/react": "^18.3.27",
		"@types/react-dom": "^18.3.7",
		"@vitest/coverage-v8": "^3.1.1",
		"@zextras/carbonio-ui-configs": "2.1.0",
		"eslint-plugin-notice": "^1.0.0",
		"husky": "^9.1.7",
		"is-ci": "^4.1.0",
		"jsdom": "^26.0.0",
		"msw": "^2.2.3",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"rollup": "^4.35.0",
		"sonar-scanner": "^3.1.0",
		"typescript": "^5.8.2",
		"vitest": "^3.0.8"
	},
	"dependencies": {
		"@types/ua-parser-js": "^0.7.39",
		"ua-parser-js": "^1.0.37"
	}
}
